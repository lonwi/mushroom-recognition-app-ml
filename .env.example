# Copy to .env and fill in locally. Do not commit .env or real tokens.

# Hugging Face dataset repo (owner/name) used for training and OOD manifests.
HF_DATASET_REPO=

# Hugging Face model repo (owner/name) for tagged .tflite + model-manifest.json releases.
HF_MODEL_REPO=

# Optional. Required for private repositories. Never commit a real token.
HF_TOKEN=

# Optional path to the HMAC train/val/test split salt. Never commit the salt file.
GRZYBOBRANIE_SPLIT_SALT_PATH=~/.config/grzybobranie/split_salt
